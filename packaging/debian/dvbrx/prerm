#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -e
DKMS_VER=@DKMS_VER@

case "$1" in
remove | deconfigure)
    if [ -d /run/systemd/system ]; then
        systemctl stop 'dvbrxd@*.service' 2>/dev/null || true
    fi
    ;;
esac
# the module of this version goes, the next version's postinst adds its own
case "$1" in
remove | upgrade | deconfigure)
    if command -v dkms >/dev/null && dkms status -m dvbrx -v "$DKMS_VER" 2>/dev/null | grep -q .; then
        dkms remove -m dvbrx -v "$DKMS_VER" --all || true
    fi
    ;;
esac
exit 0
