[Unit]
Description=dvbrx SDR DVB-S/S2/S2X receiver for /dev/dvb/adapter%i
Documentation=file:///usr/local/share/doc/dvbrx/README.md
After=systemd-modules-load.service systemd-udev-settle.service
# the frontend is named after the SDR ("dvbrx B210 31A5B7C") once the
# daemon is ready: tvheadend reads the name when it finds the adapter
Before=tvheadend.service
ConditionPathExists=/dev/dvbrx%i

[Service]
Type=notify
User=dvbrxd
Group=video
# serial LNB controller (dialout), USB access to the USRP (plugdev)
SupplementaryGroups=dialout plugdev
EnvironmentFile=/etc/dvbrxd/%i.conf
# control socket /run/dvbrx/dvbrx-%i.sock (dvbrx-web), shared by the instances
RuntimeDirectory=dvbrx
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/bin/dvbrx -d %i $DVBRXD_ARGS
Restart=on-failure
RestartSec=2
# the receiver is soft real time: favour it over batch work
Nice=-10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/dvbrxd

[Install]
WantedBy=multi-user.target
